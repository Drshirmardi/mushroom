model DoctorService {
  id                String                     @id @default(uuid()) @db.Uuid
  clinicId          String                     @map("clinic_id") @db.Uuid
  doctorId          String                     @map("doctor_id") @db.Uuid
  serviceId         String                     @map("service_id") @db.Uuid
  visitMode         VisitMode                  @map("visit_mode")
  durationMinutes   Int                        @map("duration_minutes")
  bufferMinutes     Int                        @default(0) @map("buffer_minutes")
  priceAmount       Int                        @map("price_amount")
  currency          String                     @default("IRR") @db.Char(3)
  isActive          Boolean                    @default(false) @map("is_active")
  publicationStatus DirectoryPublicationStatus @default(UNPUBLISHED) @map("publication_status")
  publishedAt       DateTime?                  @map("published_at") @db.Timestamptz(3)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  clinic            Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor            DoctorProfile              @relation(fields: [doctorId, clinicId], references: [id, clinicId], onDelete: Restrict)
  service           Service                    @relation(fields: [serviceId, clinicId], references: [id, clinicId], onDelete: Restrict)
  appointments      Appointment[]
