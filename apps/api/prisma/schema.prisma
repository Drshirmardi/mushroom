  publicationStatus DirectoryPublicationStatus @default(UNPUBLISHED) @map("publication_status")
  publishedAt       DateTime?                  @map("published_at") @db.Timestamptz(3)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  clinic            Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctors           DoctorSpecialty[]

  @@unique([clinicId, canonicalName], map: "specialties_clinic_canonical_name_key")
  @@unique([id, clinicId], map: "specialties_id_clinic_key")
  @@index([clinicId, isActive, publicationStatus, canonicalName, id], map: "specialties_directory_idx")
  @@map("specialties")
}

model DoctorSpecialty {
  clinicId    String        @map("clinic_id") @db.Uuid
  doctorId    String        @map("doctor_id") @db.Uuid
  specialtyId String        @map("specialty_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  doctor      DoctorProfile @relation(fields: [doctorId, clinicId], references: [id, clinicId], onDelete: Restrict)
  specialty   Specialty     @relation(fields: [specialtyId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@id([doctorId, specialtyId])
  @@index([clinicId, specialtyId, doctorId], map: "doctor_specialties_specialty_idx")
  @@map("doctor_specialties")
}

model Service {
