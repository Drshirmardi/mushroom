generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum RoleCode {
  PATIENT
  DOCTOR
  STAFF
  ADMIN

  @@map("role_code")
}

enum LoginAttemptOutcome {
  PENDING
  SUCCESS
  INVALID_CREDENTIALS
  RATE_LIMITED
  ACCOUNT_DISABLED

  @@map("login_attempt_outcome")
}

enum SessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
