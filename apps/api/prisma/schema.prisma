}

enum HealthObservationMetric {
  PAIN
  MOOD
  SLEEP_HOURS
  STRESS
  ENERGY
  WEIGHT
}

enum HealthObservationUnit {
  SCORE_10
  SCORE_5
  HOURS
  KILOGRAMS
}

enum NotificationCategory {
  REMINDER
  TREATMENT
  CONTENT
  SYSTEM
}

enum NotificationDeliveryChannel {
  IN_APP
}

enum NotificationDeliveryStatus {
  DELIVERED
}

enum PatientAccessAction {
  READ
  CREATE
  UPDATE
  SIGN
  AMEND
  PUBLISH
  EXPORT

  @@map("patient_access_action")
}

// All commerce money columns are integer TOMAN. Medical service and appointment
// tariffs remain the pre-existing IRR fields and are intentionally unrelated.
enum CommerceProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("commerce_product_status")
}

enum CommerceDiscountKind {
  FIXED_AMOUNT
  PERCENTAGE

  @@map("commerce_discount_kind")
}

enum DiscountReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED

  @@map("discount_reservation_status")
}

enum InventoryLedgerEntryType {
  RECEIPT
  ADJUSTMENT
  RESERVATION
  RELEASE
  CONSUMPTION

  @@map("inventory_ledger_entry_type")
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED

  @@map("inventory_reservation_status")
}

enum CommerceShippingMethod {
  PICKUP
  COURIER

  @@map("commerce_shipping_method")
}

enum CommerceOrderStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  FULFILLMENT_PENDING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLATION_REQUESTED
  RETURN_REQUESTED
  CANCELLATION_REJECTED
  RETURN_REJECTED
  FULFILLING
  FULFILLED
  CANCELLED
  PAYMENT_FAILED
  REQUIRES_RECONCILIATION
  REFUND_PENDING
  REFUNDED

  @@map("commerce_order_status")
}

enum PaymentAttemptStatus {
  CREATED
  REDIRECT_READY
  CALLBACK_RECEIVED
  VERIFYING
  VERIFIED
  FAILED
  EXPIRED
  REQUIRES_RECONCILIATION
  CANCELLED

  @@map("payment_attempt_status")
}

enum PaymentStatus {
  VERIFIED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("payment_status")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  MANUAL_EXECUTION_PENDING
  COMPLETED
  REJECTED
  CANCELLED

  @@map("refund_status")
}

enum CredentialVersionStatus {
  ACTIVE
  RETIRED
  CRYPTO_SHREDDED

  @@map("credential_version_status")
}

enum SmsProviderCredentialStatus {
  ACTIVE
  RETIRED
  CRYPTO_SHREDDED

  @@map("sms_provider_credential_status")
}

enum OtpChallengeStatus {
  PENDING
  ACCEPTED
  FAILED
  UNKNOWN
  CONSUMED
  EXPIRED
  SUPERSEDED
  LOCKED

  @@map("otp_challenge_status")
}

enum SmsDeliveryAttemptStatus {
  PENDING
  ACCEPTED
  FAILED
  UNKNOWN

  @@map("sms_delivery_attempt_status")
}

model User {
  id                             String                          @id @default(uuid()) @db.Uuid
  phone                          String                          @unique(map: "users_phone_key") @db.VarChar(13)
  status                         UserStatus                      @default(ACTIVE)
  createdAt                      DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)
  credential                     Credential?
  sessions                       Session[]
  roles                          UserRole[]                      @relation("UserRoleUser")
  assignedRoles                  UserRole[]                      @relation("UserRoleAssignedBy")
  loginAttempts                  LoginAttempt[]
  auditEvents                    AuditEvent[]                    @relation("AuditEventActor")
  userProfile                    UserProfile?
  patientProfile                 PatientProfile?
  doctorProfile                  DoctorProfile?
  recordedIntakeRevisions        PatientMedicalIntakeRevision[]  @relation("IntakeRevisionRecordedBy")
  acceptedConsentRecords         PatientConsentRecord[]          @relation("ConsentAcceptedBy")
  withdrawnConsentRecords        PatientConsentRecord[]          @relation("ConsentWithdrawnBy")
  publishedConsentPolicies       ConsentPolicyVersion[]          @relation("ConsentPolicyPublishedBy")
  publishedAssessmentVersions    AssessmentVersion[]             @relation("AssessmentVersionPublishedBy")
  encountersStarted              Encounter[]                     @relation("EncounterStartedBy")
  encountersCompleted            Encounter[]                     @relation("EncounterCompletedBy")
  clinicalNoteRevisionAuthors    ClinicalNoteRevision[]          @relation("ClinicalNoteRevisionAuthoredBy")
  clinicalNoteRevisionSigners    ClinicalNoteRevision[]          @relation("ClinicalNoteRevisionSignedBy")
  clinicalNoteRevisionPublishers ClinicalNoteRevision[]          @relation("ClinicalNoteRevisionPublishedBy")
  clinicalRecordRevisionAuthors  ClinicalRecordRevision[]        @relation("ClinicalRecordRevisionAuthoredBy")
  clinicalRecordRevisionSigners  ClinicalRecordRevision[]        @relation("ClinicalRecordRevisionSignedBy")
  patientAccessAudits            PatientAccessAudit[]            @relation("PatientAccessAuditActor")
  clinicalClinicAccesses         ClinicalClinicAccess[]
  notifications                  Notification[]
  paymentProviderConfigRevisions PaymentProviderConfigRevision[] @relation("PaymentProviderConfigRevisionCreatedBy")
  smsProviderConfigRevisions     SmsProviderConfigRevision[]     @relation("SmsProviderConfigRevisionCreatedBy")
  approvedProductContents        CommerceProduct[]               @relation("CommerceProductContentApprovedBy")
  chatParticipants               ChatConversationParticipant[]
  chatMessages                   ChatMessage[]                   @relation("ChatMessageSender")
  chatReceipts                   ChatReceipt[]
  chatReports                    ChatModerationReport[]          @relation("ChatModerationReportReporter")
  chatReportDecisions            ChatModerationReportDecision[]  @relation("ChatReportDecisionActor")
  chatBlockRequests              ChatConversationBlock[]         @relation("ChatBlockRequestedBy")
  chatBlockReviews               ChatConversationBlock[]         @relation("ChatBlockReviewedBy")
  chatModerationActions          ChatMessageModerationAction[]
  chatLegalHoldsApplied          ChatLegalHold[]                 @relation("ChatLegalHoldAppliedBy")
  chatLegalHoldsReleased         ChatLegalHold[]                 @relation("ChatLegalHoldReleasedBy")
  chatAuditEvents                ChatAuditEvent[]

  @@map("users")
}

model Credential {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique(map: "credentials_user_id_key") @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model Session {
  id                            String                   @id @default(uuid()) @db.Uuid
  userId                        String                   @map("user_id") @db.Uuid
  refreshTokenHash              String                   @unique(map: "sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.Char(64)
  previousRefreshTokenHash      String?                  @map("previous_refresh_token_hash") @db.Char(64)
  previousRefreshTokenExpiresAt DateTime?                @map("previous_refresh_token_expires_at") @db.Timestamptz(3)
  refreshGeneration             Int                      @default(0) @map("refresh_generation")
  remembered                    Boolean                  @default(false)
  userAgent                     String?                  @map("user_agent") @db.VarChar(512)
  ipAddress                     String?                  @map("ip_address") @db.Inet
  createdAt                     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt                    DateTime                 @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt                     DateTime                 @map("expires_at") @db.Timestamptz(3)
  revokedAt                     DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedReason                 SessionRevocationReason? @map("revoked_reason")
  user                          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditEvents                   AuditEvent[]
  acceptedConsentRecords        PatientConsentRecord[]   @relation("ConsentAcceptedBySession")
  withdrawnConsentRecords       PatientConsentRecord[]   @relation("ConsentWithdrawnBySession")
  patientAccessAudits           PatientAccessAudit[]     @relation("PatientAccessAuditSession")

  @@index([userId, revokedAt, expiresAt], map: "sessions_user_active_idx")
  @@map("sessions")
}

model Role {
  id                  String                   @id @default(uuid()) @db.Uuid
  code                RoleCode                 @unique(map: "roles_code_key")
  description         String?                  @db.VarChar(255)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  users               UserRole[]
  clinicalPermissions ClinicalRolePermission[]

  @@map("roles")
}

model ClinicalRolePermission {
  roleId     String             @map("role_id") @db.Uuid
  permission ClinicalPermission
  role       Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([permission], map: "clinical_role_permissions_permission_idx")
  @@map("clinical_role_permissions")
}

model ClinicalClinicAccess {
  userId    String   @map("user_id") @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@id([userId, clinicId])
  @@index([clinicId, userId], map: "clinical_clinic_accesses_clinic_user_idx")
  @@map("clinical_clinic_accesses")
}

model UserRole {
  userId           String   @map("user_id") @db.Uuid
  roleId           String   @map("role_id") @db.Uuid
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  user             User     @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy       User?    @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId], map: "user_roles_role_id_idx")
  @@index([assignedByUserId], map: "user_roles_assigned_by_user_id_idx")
  @@map("user_roles")
}

model LoginAttempt {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String?             @map("user_id") @db.Uuid
  phone     String              @db.VarChar(32)
  outcome   LoginAttemptOutcome
  ipAddress String?             @map("ip_address") @db.Inet
  userAgent String?             @map("user_agent") @db.VarChar(512)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt], map: "login_attempts_phone_created_at_idx")
  @@index([ipAddress, createdAt], map: "login_attempts_ip_created_at_idx")
  @@index([userId, createdAt], map: "login_attempts_user_id_created_at_idx")
  @@map("login_attempts")
}

model AuthRateLimitBucket {
  key             String   @id @db.Char(64)
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  requestCount    Int      @map("request_count")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([updatedAt], map: "auth_rate_limit_buckets_updated_at_idx")
  @@map("auth_rate_limit_buckets")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  action         String   @db.VarChar(100)
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorSessionId String?  @map("actor_session_id") @db.Uuid
  subjectType    String?  @map("subject_type") @db.VarChar(100)
  subjectId      String?  @map("subject_id") @db.Uuid
  requestId      String?  @map("request_id") @db.VarChar(128)
  ipAddress      String?  @map("ip_address") @db.Inet
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actorUser      User?    @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorSession   Session? @relation(fields: [actorSessionId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt], map: "audit_events_actor_user_id_created_at_idx")
  @@index([action, createdAt], map: "audit_events_action_created_at_idx")
  @@index([subjectType, subjectId, createdAt], map: "audit_events_subject_created_at_idx")
  @@map("audit_events")
}

model Clinic {
  id                       String                         @id @default(uuid()) @db.Uuid
  name                     String                         @db.VarChar(160)
  timeZone                 String                         @default("Asia/Tehran") @map("time_zone") @db.VarChar(64)
  status                   ClinicStatus                   @default(ACTIVE)
  createdAt                DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  patientProfiles          PatientProfile[]
  clinicalClinicAccesses   ClinicalClinicAccess[]
  medicalIntakes           PatientMedicalIntake[]
  consentPolicies          ConsentPolicyVersion[]
  assessmentVersions       AssessmentVersion[]
  bookingEligibilityPolicy BookingEligibilityPolicy?
  doctorProfiles           DoctorProfile[]
  specialties              Specialty[]
  services                 Service[]
  doctorServices           DoctorService[]
  availabilityRules        AvailabilityRule[]
  closures                 ClinicClosure[]
  doctorExceptions         DoctorAvailabilityException[]
  appointments             Appointment[]
  appointmentHolds         AppointmentHold[]
  queueEntries             QueueEntry[]
  operationalActivities    OperationalActivity[]
  encounters               Encounter[]
  clinicalNotes            ClinicalNote[]
  diagnoses                Diagnosis[]
  allergyRecords           AllergyRecord[]
  conditionRecords         ConditionRecord[]
  healthObservations       HealthObservation[]
  notifications            Notification[]
  articleCategories        ArticleCategory[]
  articles                 Article[]
  banners                  Banner[]
  medicationStatements     MedicationStatement[]
  patientAccessAudits      PatientAccessAudit[]
  prescriptions            Prescription[]
  treatmentPlans           TreatmentPlan[]
  commerceCategories       CommerceCategory[]
  commerceProducts         CommerceProduct[]
  commerceSkus             CommerceSku[]
  inventoryItems           InventoryItem[]
  inventoryLedgerEntries   InventoryLedgerEntry[]
  commerceDiscounts        CommerceDiscount[]
  commerceShippingRates    CommerceShippingRate[]
  commerceCarts            CommerceCart[]
  commerceOrders           CommerceOrder[]
  paymentProviderConfigs   PaymentProviderConfig[]
  paymentAttempts          PaymentAttempt[]
  chatConversations        ChatConversation[]
  chatParticipants         ChatConversationParticipant[]
  chatMessages             ChatMessage[]
  chatReceipts             ChatReceipt[]
  chatReports              ChatModerationReport[]
  chatReportDecisions      ChatModerationReportDecision[]
  chatBlocks               ChatConversationBlock[]
  chatModerationActions    ChatMessageModerationAction[]
  chatLegalHolds           ChatLegalHold[]
  chatAuditEvents          ChatAuditEvent[]

  @@map("clinics")
}

model UserProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique(map: "user_profiles_user_id_key") @map("user_id") @db.Uuid
  firstName String?  @map("first_name") @db.VarChar(80)
  lastName  String?  @map("last_name") @db.VarChar(100)
  email     String?  @db.VarChar(254)
  cityName  String?  @map("city_name") @db.VarChar(100)
  gender    String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_profiles")
}

model PatientProfile {
  id                           String                         @id @default(uuid()) @db.Uuid
  userId                       String                         @unique(map: "patient_profiles_user_id_key") @map("user_id") @db.Uuid
  clinicId                     String                         @map("clinic_id") @db.Uuid
  createdAt                    DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                         User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  clinic                       Clinic                         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  medicalIntake                PatientMedicalIntake?
  consentRecords               PatientConsentRecord[]
  reportedIntakeRevisions      PatientMedicalIntakeRevision[] @relation("IntakeRevisionReportedPatient")
  assessmentSubmissions        PatientAssessmentSubmission[]
  mezajResults                 MezajResult[]
  notificationPreferences      NotificationPreference[]
  appointments                 Appointment[]
  operationalActivities        OperationalActivity[]
  encounters                   Encounter[]
  clinicalNotes                ClinicalNote[]
  diagnoses                    Diagnosis[]
  allergyRecords               AllergyRecord[]
  conditionRecords             ConditionRecord[]
  medicationStatements         MedicationStatement[]
  patientAccessAudits          PatientAccessAudit[]
  prescriptions                Prescription[]
  treatmentPlans               TreatmentPlan[]
  healthObservations           HealthObservation[]
  commerceCart                 CommerceCart?
  wishlistItems                WishlistItem[]
  commerceAddresses            CommerceAddress[]
  commerceOrders               CommerceOrder[]
  commerceDiscountReservations CommerceDiscountReservation[]
  paymentAttempts              PaymentAttempt[]
  chatConversations            ChatConversation[]

