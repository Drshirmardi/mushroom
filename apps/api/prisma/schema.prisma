  @@unique([clinicId, doctorId, serviceId, visitMode], map: "doctor_services_offering_key")
  @@unique([id, clinicId], map: "doctor_services_id_clinic_key")
  @@index([clinicId, doctorId, visitMode, isActive, publicationStatus], map: "doctor_services_doctor_mode_idx")
  @@index([clinicId, serviceId, visitMode, isActive, publicationStatus], map: "doctor_services_service_mode_idx")
  @@map("doctor_services")
}

model AvailabilityRule {
