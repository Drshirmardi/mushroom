generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum RoleCode {
  PATIENT
  DOCTOR
  STAFF
  ADMIN

  @@map("role_code")
}

enum LoginAttemptOutcome {
  SUCCESS
  INVALID_CREDENTIALS
  RATE_LIMITED
  ACCOUNT_DISABLED

  @@map("login_attempt_outcome")
}

enum SessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  ROLE_CHANGED
  REFRESH_REUSE_DETECTED
  ADMIN_REVOKED

  @@map("session_revocation_reason")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  phone         String         @unique(map: "users_phone_key") @db.VarChar(13)
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  credential    Credential?
  sessions      Session[]
  roles         UserRole[]     @relation("UserRoleUser")
  assignedRoles UserRole[]     @relation("UserRoleAssignedBy")
  loginAttempts LoginAttempt[]
  auditEvents   AuditEvent[]   @relation("AuditEventActor")

  @@map("users")
}

model Credential {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique(map: "credentials_user_id_key") @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model Session {
  id                String                   @id @default(uuid()) @db.Uuid
  userId            String                   @map("user_id") @db.Uuid
  refreshTokenHash  String                   @unique(map: "sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.Char(64)
  refreshGeneration Int                      @default(0) @map("refresh_generation")
  remembered        Boolean                  @default(false)
  userAgent         String?                  @map("user_agent") @db.VarChar(512)
  ipAddress         String?                  @map("ip_address") @db.Inet
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt        DateTime                 @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt         DateTime                 @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedReason     SessionRevocationReason? @map("revoked_reason")
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditEvents       AuditEvent[]

  @@index([userId, revokedAt, expiresAt], map: "sessions_user_active_idx")
  @@map("sessions")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        RoleCode   @unique(map: "roles_code_key")
  description String?    @db.VarChar(255)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId           String   @map("user_id") @db.Uuid
  roleId           String   @map("role_id") @db.Uuid
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  user             User     @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy       User?    @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId], map: "user_roles_role_id_idx")
  @@index([assignedByUserId], map: "user_roles_assigned_by_user_id_idx")
  @@map("user_roles")
}

model LoginAttempt {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String?             @map("user_id") @db.Uuid
  phone     String              @db.VarChar(32)
  outcome   LoginAttemptOutcome
  ipAddress String?             @map("ip_address") @db.Inet
  userAgent String?             @map("user_agent") @db.VarChar(512)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt], map: "login_attempts_phone_created_at_idx")
  @@index([ipAddress, createdAt], map: "login_attempts_ip_created_at_idx")
  @@index([userId, createdAt], map: "login_attempts_user_id_created_at_idx")
  @@map("login_attempts")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  action         String   @db.VarChar(100)
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorSessionId String?  @map("actor_session_id") @db.Uuid
  subjectType    String?  @map("subject_type") @db.VarChar(100)
  subjectId      String?  @map("subject_id") @db.Uuid
  requestId      String?  @map("request_id") @db.VarChar(128)
  ipAddress      String?  @map("ip_address") @db.Inet
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actorUser      User?    @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorSession   Session? @relation(fields: [actorSessionId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt], map: "audit_events_actor_user_id_created_at_idx")
  @@index([action, createdAt], map: "audit_events_action_created_at_idx")
  @@index([subjectType, subjectId, createdAt], map: "audit_events_subject_created_at_idx")
  @@map("audit_events")
}
