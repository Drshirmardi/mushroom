model Appointment {
  id                     String                         @id @default(uuid()) @db.Uuid
  clinicId               String                         @map("clinic_id") @db.Uuid
  patientId              String                         @map("patient_id") @db.Uuid
  doctorServiceId        String                         @map("doctor_service_id") @db.Uuid
  doctorId               String                         @map("doctor_id") @db.Uuid
  startsAt               DateTime                       @map("starts_at") @db.Timestamptz(3)
  endsAt                 DateTime                       @map("ends_at") @db.Timestamptz(3)
  status                 AppointmentStatus              @default(PENDING)
  priceAmount            Int                            @map("price_amount")
  currency               String                         @default("IRR") @db.Char(3)
  priceCapturedAt        DateTime                       @map("price_captured_at") @db.Timestamptz(3)
  idempotencyActorUserId String?                        @map("idempotency_actor_user_id") @db.Uuid
  idempotencyKey         String?                        @map("idempotency_key") @db.VarChar(255)
  idempotencyRequestHash String?                        @map("idempotency_request_hash") @db.Char(64)
  confirmedAt            DateTime?                      @map("confirmed_at") @db.Timestamptz(3)
  checkedInAt            DateTime?                      @map("checked_in_at") @db.Timestamptz(3)
  queuedAt               DateTime?                      @map("queued_at") @db.Timestamptz(3)
  startedAt              DateTime?                      @map("started_at") @db.Timestamptz(3)
  completedAt            DateTime?                      @map("completed_at") @db.Timestamptz(3)
  cancelledAt            DateTime?                      @map("cancelled_at") @db.Timestamptz(3)
  noShowAt               DateTime?                      @map("no_show_at") @db.Timestamptz(3)
  cancelReason           String?                        @map("cancel_reason") @db.VarChar(500)
  createdAt              DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  clinic                 Clinic                         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient                PatientProfile                 @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  doctorService          DoctorService                  @relation(fields: [doctorServiceId, clinicId], references: [id, clinicId], onDelete: Restrict)
  doctor                 DoctorProfile                  @relation(fields: [doctorId, clinicId], references: [id, clinicId], onDelete: Restrict)
  statusHistory          AppointmentStatusHistory[]
  queueEntry             QueueEntry?
  operationalActivities  OperationalActivity[]

  @@unique([id, clinicId], map: "appointments_id_clinic_key")
  @@unique([idempotencyActorUserId, idempotencyKey], map: "appointments_idempotency_key")
  @@index([clinicId, patientId, startsAt, id], map: "appointments_patient_list_idx")
  @@index([clinicId, doctorId, startsAt, id], map: "appointments_doctor_schedule_idx")
  @@index([clinicId, status, startsAt, id], map: "appointments_operations_idx")
  @@map("appointments")
}

model AppointmentHold {
