}

enum ContentPublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("content_publication_status")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED

  @@map("outbox_event_status")
}

enum VisitMode {
