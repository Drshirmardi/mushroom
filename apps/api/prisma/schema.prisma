generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum RoleCode {
  PATIENT
  DOCTOR
  STAFF
  ADMIN

  @@map("role_code")
}

enum LoginAttemptOutcome {
  PENDING
  SUCCESS
  INVALID_CREDENTIALS
  RATE_LIMITED
  ACCOUNT_DISABLED

  @@map("login_attempt_outcome")
}

enum SessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  ROLE_CHANGED
  REFRESH_REUSE_DETECTED
  ADMIN_REVOKED

  @@map("session_revocation_reason")
}

enum ClinicStatus {
  ACTIVE
  INACTIVE

  @@map("clinic_status")
}

enum ConsentPolicyStatus {
  DRAFT
  ACTIVE
  RETIRED

  @@map("consent_policy_status")
}

enum MedicalIntakeSubmissionState {
  DRAFT
  COMPLETE

  @@map("medical_intake_submission_state")
}

enum MedicalIntakeRevisionState {
  DRAFT
  COMPLETE

  @@map("medical_intake_revision_state")
}

enum MedicalIntakeDataOrigin {
  PATIENT_SELF_REPORTED

  @@map("medical_intake_data_origin")
}

enum MedicalIntakeRecordingMode {
  PATIENT_ENTRY
  ADMIN_ON_BEHALF_CORRECTION

  @@map("medical_intake_recording_mode")
}

enum MedicalIntakeMutationOperation {
  ADMIN_CORRECTION
  COMPLETE

  @@map("medical_intake_mutation_operation")
}

enum SexAtBirth {
  FEMALE
  MALE
  INTERSEX
  UNKNOWN
  PREFER_NOT_TO_SAY

  @@map("sex_at_birth")
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN

  @@map("blood_type")
}

enum SleepDurationBand {
  LESS_THAN_5_HOURS
  FROM_5_TO_LESS_THAN_7_HOURS
  FROM_7_TO_9_HOURS
  MORE_THAN_9_HOURS
  UNKNOWN

  @@map("sleep_duration_band")
}

enum ExerciseFrequency {
  NONE
  ONCE_OR_TWICE_WEEKLY
  THREE_OR_FOUR_TIMES_WEEKLY
  DAILY
  UNKNOWN

  @@map("exercise_frequency")
}

enum StressLevel {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
  UNKNOWN

  @@map("stress_level")
}

enum TobaccoUse {
  NEVER
  FORMER
  CURRENT
  UNKNOWN

  @@map("tobacco_use")
}

enum ConsentSource {
  PATIENT_APP

  @@map("consent_source")
}

enum AssessmentVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@map("assessment_version_status")
}

enum PatientAssessmentState {
  IN_PROGRESS
  COMPLETE
  INVALIDATED

  @@map("patient_assessment_state")
}

enum BookingAssessmentRequirement {
  NOT_REQUIRED
  REQUIRED

  @@map("booking_assessment_requirement")
}

enum DirectoryPublicationStatus {
  UNPUBLISHED
  PUBLISHED

  @@map("directory_publication_status")
}

enum VisitMode {
  IN_PERSON
  ONLINE

  @@map("visit_mode")
}

enum DoctorAvailabilityExceptionKind {
  AVAILABLE
  UNAVAILABLE

  @@map("doctor_availability_exception_kind")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  QUEUED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED

  @@map("appointment_status")
}

enum AppointmentStatusHistoryAction {
  CREATED
  CONFIRMED
  CANCELLED
  RESCHEDULED
  CHECKED_IN
  QUEUED
  STARTED
  COMPLETED
  NO_SHOW

  @@map("appointment_status_history_action")
}

model User {
  id                          String                         @id @default(uuid()) @db.Uuid
  phone                       String                         @unique(map: "users_phone_key") @db.VarChar(13)
  status                      UserStatus                     @default(ACTIVE)
  createdAt                   DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  credential                  Credential?
  sessions                    Session[]
  roles                       UserRole[]                     @relation("UserRoleUser")
  assignedRoles               UserRole[]                     @relation("UserRoleAssignedBy")
  loginAttempts               LoginAttempt[]
  auditEvents                 AuditEvent[]                   @relation("AuditEventActor")
  userProfile                 UserProfile?
  patientProfile              PatientProfile?
  doctorProfile               DoctorProfile?
  recordedIntakeRevisions     PatientMedicalIntakeRevision[] @relation("IntakeRevisionRecordedBy")
  acceptedConsentRecords      PatientConsentRecord[]         @relation("ConsentAcceptedBy")
  withdrawnConsentRecords     PatientConsentRecord[]         @relation("ConsentWithdrawnBy")
  publishedConsentPolicies    ConsentPolicyVersion[]         @relation("ConsentPolicyPublishedBy")
  publishedAssessmentVersions AssessmentVersion[]            @relation("AssessmentVersionPublishedBy")

  @@map("users")
}

model Credential {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique(map: "credentials_user_id_key") @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model Session {
  id                      String                   @id @default(uuid()) @db.Uuid
  userId                  String                   @map("user_id") @db.Uuid
  refreshTokenHash        String                   @unique(map: "sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.Char(64)
  refreshGeneration       Int                      @default(0) @map("refresh_generation")
  remembered              Boolean                  @default(false)
  userAgent               String?                  @map("user_agent") @db.VarChar(512)
  ipAddress               String?                  @map("ip_address") @db.Inet
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt              DateTime                 @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt               DateTime                 @map("expires_at") @db.Timestamptz(3)
  revokedAt               DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedReason           SessionRevocationReason? @map("revoked_reason")
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditEvents             AuditEvent[]
  acceptedConsentRecords  PatientConsentRecord[]   @relation("ConsentAcceptedBySession")
  withdrawnConsentRecords PatientConsentRecord[]   @relation("ConsentWithdrawnBySession")

  @@index([userId, revokedAt, expiresAt], map: "sessions_user_active_idx")
  @@map("sessions")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        RoleCode   @unique(map: "roles_code_key")
  description String?    @db.VarChar(255)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId           String   @map("user_id") @db.Uuid
  roleId           String   @map("role_id") @db.Uuid
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  user             User     @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy       User?    @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId], map: "user_roles_role_id_idx")
  @@index([assignedByUserId], map: "user_roles_assigned_by_user_id_idx")
  @@map("user_roles")
}

model LoginAttempt {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String?             @map("user_id") @db.Uuid
  phone     String              @db.VarChar(32)
  outcome   LoginAttemptOutcome
  ipAddress String?             @map("ip_address") @db.Inet
  userAgent String?             @map("user_agent") @db.VarChar(512)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt], map: "login_attempts_phone_created_at_idx")
  @@index([ipAddress, createdAt], map: "login_attempts_ip_created_at_idx")
  @@index([userId, createdAt], map: "login_attempts_user_id_created_at_idx")
  @@map("login_attempts")
}

model AuthRateLimitBucket {
  key             String   @id @db.Char(64)
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  requestCount    Int      @map("request_count")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([updatedAt], map: "auth_rate_limit_buckets_updated_at_idx")
  @@map("auth_rate_limit_buckets")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  action         String   @db.VarChar(100)
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorSessionId String?  @map("actor_session_id") @db.Uuid
  subjectType    String?  @map("subject_type") @db.VarChar(100)
  subjectId      String?  @map("subject_id") @db.Uuid
  requestId      String?  @map("request_id") @db.VarChar(128)
  ipAddress      String?  @map("ip_address") @db.Inet
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actorUser      User?    @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorSession   Session? @relation(fields: [actorSessionId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt], map: "audit_events_actor_user_id_created_at_idx")
  @@index([action, createdAt], map: "audit_events_action_created_at_idx")
  @@index([subjectType, subjectId, createdAt], map: "audit_events_subject_created_at_idx")
  @@map("audit_events")
}

model Clinic {
  id                       String                        @id @default(uuid()) @db.Uuid
  name                     String                        @db.VarChar(160)
  timeZone                 String                        @default("Asia/Tehran") @map("time_zone") @db.VarChar(64)
  status                   ClinicStatus                  @default(ACTIVE)
  createdAt                DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  patientProfiles          PatientProfile[]
  medicalIntakes           PatientMedicalIntake[]
  consentPolicies          ConsentPolicyVersion[]
  assessmentVersions       AssessmentVersion[]
  bookingEligibilityPolicy BookingEligibilityPolicy?
  doctorProfiles           DoctorProfile[]
  specialties              Specialty[]
  services                 Service[]
  doctorServices           DoctorService[]
  availabilityRules        AvailabilityRule[]
  closures                 ClinicClosure[]
  doctorExceptions         DoctorAvailabilityException[]
  appointments             Appointment[]
  appointmentHolds         AppointmentHold[]
  queueEntries             QueueEntry[]
  operationalActivities    OperationalActivity[]

  @@map("clinics")
}

model UserProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique(map: "user_profiles_user_id_key") @map("user_id") @db.Uuid
  firstName String?  @map("first_name") @db.VarChar(80)
  lastName  String?  @map("last_name") @db.VarChar(100)
  email     String?  @db.VarChar(254)
  cityName  String?  @map("city_name") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_profiles")
}

model PatientProfile {
  id                      String                         @id @default(uuid()) @db.Uuid
  userId                  String                         @unique(map: "patient_profiles_user_id_key") @map("user_id") @db.Uuid
  clinicId                String                         @map("clinic_id") @db.Uuid
  createdAt               DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                    User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  clinic                  Clinic                         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  medicalIntake           PatientMedicalIntake?
  consentRecords          PatientConsentRecord[]
  reportedIntakeRevisions PatientMedicalIntakeRevision[] @relation("IntakeRevisionReportedPatient")
  assessmentSubmissions   PatientAssessmentSubmission[]
  appointments            Appointment[]
  operationalActivities   OperationalActivity[]

  @@unique([id, clinicId], map: "patient_profiles_id_clinic_key")
  @@index([clinicId, createdAt], map: "patient_profiles_clinic_created_at_idx")
  @@map("patient_profiles")
}

model PatientMedicalIntake {
  id                      String                         @id @default(uuid()) @db.Uuid
  patientId               String                         @unique(map: "patient_medical_intakes_patient_id_key") @map("patient_id") @db.Uuid
  clinicId                String                         @map("clinic_id") @db.Uuid
  assignedSchemaVersion   Int                            @default(1) @map("assigned_schema_version")
  currentRevisionNumber   Int                            @default(0) @map("current_revision_number")
  completedRevisionNumber Int?                           @map("completed_revision_number")
  submissionState         MedicalIntakeSubmissionState   @default(DRAFT) @map("submission_state")
  createdAt               DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  patient                 PatientProfile                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic                  Clinic                         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  revisions               PatientMedicalIntakeRevision[]

  @@index([clinicId, submissionState, updatedAt], map: "patient_medical_intakes_clinic_state_updated_at_idx")
  @@map("patient_medical_intakes")
}

model PatientMedicalIntakeRevision {
  id                       String                          @id @default(uuid()) @db.Uuid
  intakeId                 String                          @map("intake_id") @db.Uuid
  revisionNumber           Int                             @map("revision_number")
  assignedSchemaVersion    Int                             @map("assigned_schema_version")
  revisionState            MedicalIntakeRevisionState      @map("revision_state")
  birthDate                DateTime?                       @map("birth_date") @db.Date
  sexAtBirth               SexAtBirth?                     @map("sex_at_birth")
  heightCm                 Int?                            @map("height_cm")
  weightKg                 Decimal?                        @map("weight_kg") @db.Decimal(6, 2)
  bloodType                BloodType?                      @map("blood_type")
  allergyReport            Json?                           @map("allergy_report")
  chronicConditionReport   Json?                           @map("chronic_condition_report")
  currentMedicationReport  Json?                           @map("current_medication_report")
  sleepDurationBand        SleepDurationBand?              @map("sleep_duration_band")
  exerciseFrequency        ExerciseFrequency?              @map("exercise_frequency")
  stressLevel              StressLevel?                    @map("stress_level")
  tobaccoUse               TobaccoUse?                     @map("tobacco_use")
  dataOrigin               MedicalIntakeDataOrigin         @default(PATIENT_SELF_REPORTED) @map("data_origin")
  recordingMode            MedicalIntakeRecordingMode      @map("recording_mode")
  reportedPatientId        String                          @map("reported_patient_id") @db.Uuid
  recordedByUserId         String?                         @map("recorded_by_user_id") @db.Uuid
  correctionReason         String?                         @map("correction_reason") @db.VarChar(500)
  completedAt              DateTime?                       @map("completed_at") @db.Timestamptz(3)
  completedConsentRecordId String?                         @map("completed_consent_record_id") @db.Uuid
  mutationOperation        MedicalIntakeMutationOperation? @map("mutation_operation")
  mutationKey              String?                         @map("mutation_key") @db.VarChar(255)
  payloadHash              String                          @map("payload_hash") @db.Char(64)
  createdAt                DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  intake                   PatientMedicalIntake            @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  reportedPatient          PatientProfile                  @relation("IntakeRevisionReportedPatient", fields: [reportedPatientId], references: [id], onDelete: Restrict)
  recordedByUser           User?                           @relation("IntakeRevisionRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  completedConsentRecord   PatientConsentRecord?           @relation(fields: [completedConsentRecordId], references: [id], onDelete: Restrict)

  @@unique([intakeId, revisionNumber], map: "patient_medical_intake_revisions_intake_revision_key")
  @@unique([intakeId, mutationOperation, mutationKey], map: "patient_medical_intake_revisions_mutation_key")
  @@map("patient_medical_intake_revisions")
}

model ConsentPolicyVersion {
  id                String                 @id @default(uuid()) @db.Uuid
  clinicId          String                 @map("clinic_id") @db.Uuid
  policyKey         String                 @map("policy_key") @db.VarChar(100)
  versionNumber     Int                    @map("version_number")
  locale            String                 @default("fa-IR") @db.VarChar(16)
  title             String                 @db.VarChar(255)
  body              String                 @db.Text
  contentHash       String                 @map("content_hash") @db.Char(64)
  status            ConsentPolicyStatus    @default(DRAFT)
  activatedAt       DateTime?              @map("activated_at") @db.Timestamptz(3)
  retiredAt         DateTime?              @map("retired_at") @db.Timestamptz(3)
  publishedByUserId String?                @map("published_by_user_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  clinic            Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  publishedByUser   User?                  @relation("ConsentPolicyPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  consentRecords    PatientConsentRecord[]

  @@unique([clinicId, policyKey, locale, versionNumber], map: "consent_policy_versions_version_key")
  @@map("consent_policy_versions")
}

model PatientConsentRecord {
  id                       String                         @id @default(uuid()) @db.Uuid
  patientId                String                         @map("patient_id") @db.Uuid
  policyVersionId          String                         @map("policy_version_id") @db.Uuid
  contentHash              String                         @map("content_hash") @db.Char(64)
  acceptedAt               DateTime                       @default(now()) @map("accepted_at") @db.Timestamptz(3)
  acceptedByUserId         String?                        @map("accepted_by_user_id") @db.Uuid
  acceptedBySessionId      String?                        @map("accepted_by_session_id") @db.Uuid
  source                   ConsentSource                  @default(PATIENT_APP)
  withdrawnAt              DateTime?                      @map("withdrawn_at") @db.Timestamptz(3)
  withdrawnByUserId        String?                        @map("withdrawn_by_user_id") @db.Uuid
  withdrawnBySessionId     String?                        @map("withdrawn_by_session_id") @db.Uuid
  acceptanceIdempotencyKey String?                        @map("acceptance_idempotency_key") @db.VarChar(255)
  withdrawalIdempotencyKey String?                        @map("withdrawal_idempotency_key") @db.VarChar(255)
  acceptanceRequestId      String?                        @map("acceptance_request_id") @db.VarChar(128)
  withdrawalRequestId      String?                        @map("withdrawal_request_id") @db.VarChar(128)
  createdAt                DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  patient                  PatientProfile                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  policyVersion            ConsentPolicyVersion           @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  acceptedByUser           User?                          @relation("ConsentAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  withdrawnByUser          User?                          @relation("ConsentWithdrawnBy", fields: [withdrawnByUserId], references: [id], onDelete: SetNull)
  acceptedBySession        Session?                       @relation("ConsentAcceptedBySession", fields: [acceptedBySessionId], references: [id], onDelete: SetNull)
  withdrawnBySession       Session?                       @relation("ConsentWithdrawnBySession", fields: [withdrawnBySessionId], references: [id], onDelete: SetNull)
  completedRevisions       PatientMedicalIntakeRevision[]

  @@map("patient_consent_records")
}

model AssessmentVersion {
  id                        String                        @id @default(uuid()) @db.Uuid
  clinicId                  String                        @map("clinic_id") @db.Uuid
  assessmentKey             String                        @map("assessment_key") @db.VarChar(100)
  versionNumber             Int                           @map("version_number")
  locale                    String                        @default("fa-IR") @db.VarChar(16)
  title                     String                        @db.VarChar(255)
  structure                 Json
  contentHash               String                        @map("content_hash") @db.Char(64)
  status                    AssessmentVersionStatus       @default(DRAFT)
  publishedAt               DateTime?                     @map("published_at") @db.Timestamptz(3)
  retiredAt                 DateTime?                     @map("retired_at") @db.Timestamptz(3)
  publishedByUserId         String?                       @map("published_by_user_id") @db.Uuid
  createdAt                 DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  clinic                    Clinic                        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  publishedByUser           User?                         @relation("AssessmentVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  submissions               PatientAssessmentSubmission[]
  requiredByBookingPolicies BookingEligibilityPolicy[]    @relation("BookingPolicyRequiredVersion")

  @@unique([clinicId, assessmentKey, locale, versionNumber], map: "assessment_versions_version_key")
  @@unique([id, clinicId], map: "assessment_versions_id_clinic_key")
  @@map("assessment_versions")
}

model PatientAssessmentSubmission {
  id                       String                 @id @default(uuid()) @db.Uuid
  patientId                String                 @map("patient_id") @db.Uuid
  assessmentVersionId      String                 @map("assessment_version_id") @db.Uuid
  attemptNumber            Int                    @default(1) @map("attempt_number")
  state                    PatientAssessmentState @default(IN_PROGRESS)
  answers                  Json                   @default("{}")
  score                    Decimal?               @db.Decimal(8, 2)
  resultSnapshot           Json?                  @map("result_snapshot")
  startedAt                DateTime               @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt              DateTime?              @map("completed_at") @db.Timestamptz(3)
  invalidatedAt            DateTime?              @map("invalidated_at") @db.Timestamptz(3)
  completionIdempotencyKey String?                @map("completion_idempotency_key") @db.VarChar(255)
  completionPayloadHash    String?                @map("completion_payload_hash") @db.Char(64)
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  patient                  PatientProfile         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  assessmentVersion        AssessmentVersion      @relation(fields: [assessmentVersionId], references: [id], onDelete: Restrict)

  @@unique([patientId, assessmentVersionId, attemptNumber], map: "patient_assessment_submissions_attempt_key")
  @@index([patientId, state, completedAt], map: "patient_assessment_submissions_eligibility_idx")
  @@map("patient_assessment_submissions")
}

model BookingEligibilityPolicy {
  id                            String                       @id @default(uuid()) @db.Uuid
  clinicId                      String                       @unique(map: "booking_eligibility_policies_clinic_id_key") @map("clinic_id") @db.Uuid
  assessmentRequirement         BookingAssessmentRequirement @default(NOT_REQUIRED) @map("assessment_requirement")
  requiredAssessmentVersionId   String?                      @map("required_assessment_version_id") @db.Uuid
  validityDays                  Int?                         @map("validity_days")
  requireLatestPublishedVersion Boolean                      @default(false) @map("require_latest_published_version")
  createdAt                     DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  clinic                        Clinic                       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  requiredAssessmentVersion     AssessmentVersion?           @relation("BookingPolicyRequiredVersion", fields: [requiredAssessmentVersionId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@map("booking_eligibility_policies")
}

model DoctorProfile {
  id                String                        @id @default(uuid()) @db.Uuid
  clinicId          String                        @map("clinic_id") @db.Uuid
  userId            String?                       @unique(map: "doctor_profiles_user_id_key") @map("user_id") @db.Uuid
  displayName       String                        @map("display_name") @db.VarChar(160)
  biography         String?                       @db.Text
  yearsExperience   Int?                          @map("years_experience")
  profileImageUrl   String?                       @map("profile_image_url") @db.VarChar(2048)
  languages         String[]                      @default([])
  education         String[]                      @default([])
  certifications    String[]                      @default([])
  isActive          Boolean                       @default(false) @map("is_active")
  publicationStatus DirectoryPublicationStatus    @default(UNPUBLISHED) @map("publication_status")
  publishedAt       DateTime?                     @map("published_at") @db.Timestamptz(3)
  createdAt         DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  clinic            Clinic                        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  user              User?                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  specialties       DoctorSpecialty[]
  doctorServices    DoctorService[]
  availabilityRules AvailabilityRule[]
  exceptions        DoctorAvailabilityException[]
  appointments      Appointment[]
  appointmentHolds  AppointmentHold[]
  queueEntries      QueueEntry[]

  @@unique([id, clinicId], map: "doctor_profiles_id_clinic_key")
  @@index([clinicId, isActive, publicationStatus, displayName, id], map: "doctor_profiles_directory_idx")
  @@map("doctor_profiles")
}

model Specialty {
  id                String                     @id @default(uuid()) @db.Uuid
  clinicId          String                     @map("clinic_id") @db.Uuid
  name              String                     @db.VarChar(160)
  canonicalName     String                     @map("canonical_name") @db.VarChar(320)
  description       String?                    @db.VarChar(1000)
