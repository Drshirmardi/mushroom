enum AppointmentStatusHistoryAction {
  CREATED
  CONFIRMED
  CANCELLED
  RESCHEDULED
  CHECKED_IN
  QUEUED
  STARTED
  COMPLETED
  NO_SHOW

  @@map("appointment_status_history_action")
}

enum EncounterState {
  IN_PROGRESS
  COMPLETED
  VOIDED

  @@map("encounter_state")
}

enum ClinicalRecordState {
  DRAFT
  ACTIVE
  INACTIVE
  SUPERSEDED
  VOIDED

  @@map("clinical_record_state")
}

enum ClinicalNoteRevisionState {
  DRAFT
  SIGNED
  VOIDED

  @@map("clinical_note_revision_state")
}

enum ClinicalRecordRevisionState {
  DRAFT
  SIGNED
  VOIDED

  @@map("clinical_record_revision_state")
}

enum ClinicalPermission {
  CLINICAL_RECORD_VIEW
  CLINICAL_RECORD_EDIT
  CLINICAL_RECORD_SIGN
  CLINICAL_RECORD_AMEND
  PRESCRIPTION_ISSUE

  @@map("clinical_permission")
}

enum PrescriptionRevisionState {
  DRAFT
  ISSUED
  VOIDED

  @@map("prescription_revision_state")
}

enum TreatmentPlanState {
  DRAFT
  ACTIVE
  COMPLETED
  VOIDED

  @@map("treatment_plan_state")
}

enum TreatmentTaskState {
  SCHEDULED
  COMPLETED
  CANCELLED

