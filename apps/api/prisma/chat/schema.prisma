generator client {
  provider = "prisma-client"
  output = "../../src/generated/chat-prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model ChatCall {
  id                String   @id @default(uuid()) @db.Uuid
  appointmentId     String   @db.Uuid
  callerUserId      String   @db.Uuid
  callerSessionId   String   @db.Uuid
  callerName        String
  callerKind        ChatParticipantKind
  patientUserId     String   @db.Uuid
  patientSessionId  String?  @db.Uuid
  mode              ChatCallMode @default(VIDEO)
  answeredAt        DateTime?
  callerConnectedAt DateTime?
  patientConnectedAt DateTime?
  connectedAt        DateTime?
  status            ChatCallStatus
  ringsUntil        DateTime
  endedAt           DateTime?
  // Legacy call lease kept for migration history. New writes use the per-party leases.
  lastLeaseAt       DateTime?
  callerLeaseAt     DateTime?
  patientLeaseAt    DateTime?
  endReason         String?
  createdAt         DateTime @default(now())

  @@index([patientUserId, status, ringsUntil])
  @@index([appointmentId, status])
  // Communications migration 20261122100000 also creates chat_calls_one_live_per_caller,
  // a partial unique index on callerUserId for RINGING or ACTIVE. Preserve it in future migrations.
  @@index([status, lastLeaseAt])
  @@map("chat_calls")
}

enum ChatCallMode {
  AUDIO
  VIDEO
}

enum ChatCallStatus {
  CANCELLED
  FAILED
  RINGING
  ACTIVE
  DECLINED
  MISSED
  ENDED
}

enum ChatParticipantKind {
  PATIENT
  DOCTOR
  CLINIC_OPERATOR

  @@map("chat_participant_kind")
}

enum ChatMessageVisibility {
  VISIBLE
  RESTRICTED

  @@map("chat_message_visibility")
}

enum ChatModerationReasonCategory {
  ABUSE_OR_HARASSMENT
  THREAT_OR_SAFETY
  SENSITIVE_DATA_EXPOSURE
  SPAM_OR_SCAM
  MALICIOUS_CONTENT
  OTHER

  @@map("chat_moderation_reason_category")
}

enum ChatMessageModerationActionType {
  RESTRICT_MESSAGE
  RESTORE_MESSAGE

  @@map("chat_message_moderation_action")
}

enum ChatReportResolutionAction {
  NO_ADDITIONAL_ACTION
  RESTRICT_MESSAGE
  RECORD_WARNING
  CONFIRM_PATIENT_DOCTOR_BLOCK
  CONFIRM_PATIENT_CLINIC_OPERATOR_BLOCK
  LIFT_TEMPORARY_BLOCK

  @@map("chat_report_resolution_action")
}

enum ChatReportResolution {
  DISMISSED_NO_VIOLATION
  UPHELD_POLICY_VIOLATION
  INSUFFICIENT_EVIDENCE
  ESCALATED_SAFETY_OR_LEGAL

  @@map("chat_report_resolution")
}

enum ChatBlockScope {
  PATIENT_DOCTOR
  PATIENT_CLINIC_OPERATOR

  @@map("chat_block_scope")
}

enum ChatBlockStatus {
  PENDING_REVIEW
  CONFIRMED
  LIFTED

  @@map("chat_block_status")
}

enum ChatAuditAction {
  MESSAGE_CREATED
  MESSAGE_RESTRICTED
  MESSAGE_RESTORED
  RESTRICTED_CONTENT_REVIEWED
  REPORT_CREATED
  REPORT_RESOLVED
  BLOCK_REQUESTED
  BLOCK_CONFIRMED
  BLOCK_LIFTED
  LEGAL_HOLD_APPLIED
  LEGAL_HOLD_RELEASED
  RETENTION_DISPOSITION_ATTEMPTED

  @@map("chat_audit_action")
}

model ChatConversation {
  id                 String                        @id @default(uuid()) @db.Uuid
  clinicId           String                        @map("clinic_id") @db.Uuid
  appointmentId      String                        @unique(map: "chat_conversations_appointment_id_key") @map("appointment_id") @db.Uuid
  patientId          String                        @map("patient_id") @db.Uuid
  doctorId           String                        @map("doctor_id") @db.Uuid
  closedAt           DateTime?                     @map("closed_at") @db.Timestamptz(3)
  retentionBaseAt    DateTime?                     @map("retention_base_at") @db.Timestamptz(3)
  retentionExpiresAt DateTime?                     @map("retention_expires_at") @db.Timestamptz(3)
  createdAt          DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  participants       ChatConversationParticipant[]
  messages           ChatMessage[]
  receipts           ChatReceipt[]
  reports            ChatModerationReport[]
  blocks             ChatConversationBlock[]
  moderationActions  ChatMessageModerationAction[]
  legalHolds         ChatLegalHold[]
  auditEvents        ChatAuditEvent[]

  @@unique([id, clinicId], map: "chat_conversations_id_clinic_key")
  @@unique([appointmentId, clinicId], map: "chat_conversations_appointment_clinic_key")
  @@index([clinicId, patientId, createdAt, id], map: "chat_conversations_clinic_patient_created_idx")
  @@index([clinicId, doctorId, createdAt, id], map: "chat_conversations_clinic_doctor_created_idx")
  @@map("chat_conversations")
}

model ChatConversationParticipant {
  id             String              @id @default(uuid()) @db.Uuid
  clinicId       String              @map("clinic_id") @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  kind           ChatParticipantKind
  joinedAt       DateTime            @default(now()) @map("joined_at") @db.Timestamptz(3)
  conversation   ChatConversation    @relation(fields: [conversationId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@unique([conversationId, userId, kind], map: "chat_conversation_participants_identity_key")
  @@index([clinicId, userId, conversationId], map: "chat_conversation_participants_clinic_user_idx")
  @@map("chat_conversation_participants")
}

model ChatMessage {
  id                       String                        @id @default(uuid()) @db.Uuid
  clinicId                 String                        @map("clinic_id") @db.Uuid
  conversationId           String                        @map("conversation_id") @db.Uuid
  sequence                 BigInt                        @map("sequence")
  senderUserId             String                        @map("sender_user_id") @db.Uuid
  senderKind               ChatParticipantKind           @map("sender_kind")
  clientMessageId          String                        @map("client_message_id") @db.VarChar(128)
  requestPayloadHash       String                        @map("request_payload_hash") @db.Char(64)
  callId                   String?                       @unique @map("call_id") @db.Uuid
  attachment               Json?
  body                     String                        @db.Text
  visibility               ChatMessageVisibility         @default(VISIBLE)
  restrictedReasonCategory ChatModerationReasonCategory? @map("restricted_reason_category")
  restrictedAt             DateTime?                     @map("restricted_at") @db.Timestamptz(3)
  createdAt                DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  conversation             ChatConversation              @relation(fields: [conversationId, clinicId], references: [id, clinicId], onDelete: Restrict)
  reports                  ChatModerationReport[]
  moderationActions        ChatMessageModerationAction[]

  @@unique([id, conversationId, clinicId], map: "chat_messages_id_conversation_clinic_key")
  @@unique([conversationId, sequence], map: "chat_messages_conversation_sequence_key")
  @@unique([conversationId, senderUserId, clientMessageId], map: "chat_messages_idempotency_key")
  @@index([clinicId, conversationId, sequence], map: "chat_messages_clinic_history_idx")
  @@index([senderUserId, createdAt], map: "chat_messages_sender_created_at_idx")
  @@index([conversationId, createdAt], map: "chat_messages_conversation_created_at_idx")
  @@map("chat_messages")
}

model ChatReceipt {
  id                    String           @id @default(uuid()) @db.Uuid
  clinicId              String           @map("clinic_id") @db.Uuid
  conversationId        String           @map("conversation_id") @db.Uuid
  userId                String           @map("user_id") @db.Uuid
  lastDeliveredSequence BigInt           @default(0) @map("last_delivered_sequence")
  lastReadSequence      BigInt           @default(0) @map("last_read_sequence")
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  conversation          ChatConversation @relation(fields: [conversationId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@unique([conversationId, userId], map: "chat_receipts_conversation_user_key")
  @@index([clinicId, userId, conversationId], map: "chat_receipts_clinic_user_idx")
  @@map("chat_receipts")
}

model ChatModerationReport {
  id             String                        @id @default(uuid()) @db.Uuid
  clinicId       String                        @map("clinic_id") @db.Uuid
  conversationId String                        @map("conversation_id") @db.Uuid
  messageId      String                        @map("message_id") @db.Uuid
  reporterUserId String                        @map("reporter_user_id") @db.Uuid
  reasonCategory ChatModerationReasonCategory  @map("reason_category")
  reporterNote   String?                       @map("reporter_note") @db.VarChar(500)
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  conversation   ChatConversation              @relation(fields: [conversationId, clinicId], references: [id, clinicId], onDelete: Restrict)
  message        ChatMessage                   @relation(fields: [messageId, conversationId, clinicId], references: [id, conversationId, clinicId], onDelete: Restrict)
  decision       ChatModerationReportDecision?

  @@unique([messageId, reporterUserId], map: "chat_moderation_reports_message_reporter_key")
  @@index([clinicId, conversationId, createdAt, id], map: "chat_moderation_reports_conversation_created_idx")
  @@index([clinicId, messageId, createdAt, id], map: "chat_moderation_reports_message_created_idx")
  @@map("chat_moderation_reports")
}

model ChatModerationReportDecision {
  id          String                     @id @default(uuid()) @db.Uuid
  clinicId    String                     @map("clinic_id") @db.Uuid
  reportId    String                     @unique(map: "chat_moderation_report_decisions_report_id_key") @map("report_id") @db.Uuid
  actorUserId String                     @map("actor_user_id") @db.Uuid
  resolution  ChatReportResolution
  action      ChatReportResolutionAction
  safeNote    String?                    @map("safe_note") @db.VarChar(500)
  decidedAt   DateTime                   @default(now()) @map("decided_at") @db.Timestamptz(3)
  report      ChatModerationReport       @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@index([clinicId, resolution, decidedAt, id], map: "chat_report_decisions_clinic_resolution_idx")
  @@map("chat_moderation_report_decisions")
}

model ChatConversationBlock {
  id                String           @id @default(uuid()) @db.Uuid
  clinicId          String           @map("clinic_id") @db.Uuid
  conversationId    String           @map("conversation_id") @db.Uuid
  scope             ChatBlockScope
  status            ChatBlockStatus  @default(PENDING_REVIEW)
  requestedByUserId String           @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime         @default(now()) @map("requested_at") @db.Timestamptz(3)
  reviewedByUserId  String?          @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  safeReason        String?          @map("safe_reason") @db.VarChar(500)
  conversation      ChatConversation @relation(fields: [conversationId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@index([clinicId, conversationId, scope, status], map: "chat_blocks_conversation_scope_status_idx")
  @@map("chat_conversation_blocks")
}

model ChatMessageModerationAction {
  id             String                          @id @default(uuid()) @db.Uuid
  clinicId       String                          @map("clinic_id") @db.Uuid
  conversationId String                          @map("conversation_id") @db.Uuid
  messageId      String                          @map("message_id") @db.Uuid
  actorUserId    String                          @map("actor_user_id") @db.Uuid
  action         ChatMessageModerationActionType
  reasonCategory ChatModerationReasonCategory?   @map("reason_category")
  safeNote       String?                         @map("safe_note") @db.VarChar(500)
  createdAt      DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  conversation   ChatConversation                @relation(fields: [conversationId, clinicId], references: [id, clinicId], onDelete: Restrict)
  message        ChatMessage                     @relation(fields: [messageId, conversationId, clinicId], references: [id, conversationId, clinicId], onDelete: Restrict)

  @@index([clinicId, messageId, createdAt, id], map: "chat_message_moderation_actions_message_created_idx")
  @@map("chat_message_moderation_actions")
}

model ChatLegalHold {
  id               String           @id @default(uuid()) @db.Uuid
  clinicId         String           @map("clinic_id") @db.Uuid
  conversationId   String           @map("conversation_id") @db.Uuid
  appliedByUserId  String           @map("applied_by_user_id") @db.Uuid
  appliedAt        DateTime         @default(now()) @map("applied_at") @db.Timestamptz(3)
  releasedByUserId String?          @map("released_by_user_id") @db.Uuid
  releasedAt       DateTime?        @map("released_at") @db.Timestamptz(3)
  safeReason       String           @map("safe_reason") @db.VarChar(500)
  conversation     ChatConversation @relation(fields: [conversationId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@index([clinicId, conversationId, releasedAt], map: "chat_legal_holds_conversation_active_idx")
  @@map("chat_legal_holds")
}

model ChatAuditEvent {
  id             String           @id @default(uuid()) @db.Uuid
  clinicId       String           @map("clinic_id") @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  actorUserId    String?          @map("actor_user_id") @db.Uuid
  action         ChatAuditAction
  targetType     String           @map("target_type") @db.VarChar(80)
  targetId       String           @map("target_id") @db.Uuid
  safeCategory   String?          @map("safe_category") @db.VarChar(80)
  correlationId  String?          @map("correlation_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  conversation   ChatConversation @relation(fields: [conversationId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@index([clinicId, conversationId, createdAt, id], map: "chat_audit_events_conversation_created_idx")
  @@index([clinicId, action, createdAt, id], map: "chat_audit_events_clinic_action_created_idx")
  @@map("chat_audit_events")
}
