{
  "name": "@sabz-zendegi/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prebuild": "prisma generate",
    "pretypecheck": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "consent-policy:validate": "node prisma/manage-consent-policy.mjs validate",
    "consent-policy:publish": "node prisma/manage-consent-policy.mjs publish",
    "consent-policy:verify": "node prisma/manage-consent-policy.mjs verify",
    "openapi:export": "tsc -p tsconfig.build.json && node scripts/export-openapi.mjs",
    "start": "node dist/main.js",
    "start:dev": "node scripts/dev.mjs",
    "test": "tsc -p tsconfig.test.json --noEmit && vitest run test/reminders.integration.spec.ts --no-file-parallelism && vitest run --no-file-parallelism --exclude test/reminders.integration.spec.ts --exclude test/chat-capacity.load.spec.ts --exclude test/phase-12-release-capacity.load.spec.ts --exclude test/phase-12-performance-tuning.integration.spec.ts",
    "test:capacity": "tsc -p tsconfig.test.json --noEmit && vitest run test/chat-capacity.load.spec.ts --no-file-parallelism",
    "test:commerce-mezaj": "node test/commerce-mezaj-verify.mjs",
    "test:mezaj-programs": "node test/program-mezaj-verify.mjs",
    "test:phase-12-capacity": "tsc -p tsconfig.test.json --noEmit && vitest run test/phase-12-release-capacity.load.spec.ts --no-file-parallelism",
    "test:phase-12-performance": "tsc -p tsconfig.test.json --noEmit && vitest run test/phase-12-performance-tuning.integration.spec.ts --no-file-parallelism",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "farazsms": "1.1.0",
    "fastify": "^5.12.5",
    "joi": "^18.2.9",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
