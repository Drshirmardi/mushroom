NODE_ENV=development
PORT=3003
POSTGRES_DB=sabz_zendegi
POSTGRES_USER=sabz_zendegi
POSTGRES_PASSWORD=local-development-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sabz_zendegi:local-development-password@localhost:5432/sabz_zendegi?schema=public
# Optional disposable database used only by Prisma Migrate to replay migration history.
# Configure this locally with credentials distinct from production/shared environments.
SHADOW_DATABASE_URL=
# Local-only dashboard account; the seed creates or refreshes this ADMIN account in development.
DEV_DASHBOARD_ADMIN_PHONE=+989100000001
DEV_DASHBOARD_ADMIN_PASSWORD=replace-with-a-local-password
# Use exact browser origins. For LAN testing, append the same three ports with
# the development machine's IP address; never use a wildcard.
APP_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Public HTTPS API origin used to prove that the configured Sadad callback matches this deployment.
PUBLIC_API_URL=
# Required in production: explicit load-balancer/proxy IPs or CIDRs; never use a universal range.
TRUSTED_PROXIES=
LOG_LEVEL=info
COMMERCE_RESERVATION_TTL_MINUTES=20
# Placeholder only; replace with at least 32 random bytes encoded as base64url.
JWT_ACCESS_SECRET=replace-this-placeholder-with-a-unique-32-character-secret
JWT_ACCESS_ISSUER=sabz-zendegi-api
JWT_ACCESS_AUDIENCE=sabz-zendegi-frontends
# Must be independent from JWT_ACCESS_SECRET and generated from different random bytes.
REFRESH_TOKEN_PEPPER=replace-this-placeholder-with-a-unique-refresh-token-pepper
# Independent URL-safe secret with at least 32 random bytes; used only for OTP HMAC verifiers.
OTP_PEPPER=replace-this-placeholder-with-a-unique-otp-pepper
# SMS stays fail-closed until live is selected and an ADMIN enables a configured adapter.
SMS_TRANSPORT_MODE=disabled
SMS_REQUEST_TIMEOUT_MS=5000
# External secret values; canonical base64 for exactly 32 bytes and historic version:key entries.
SMS_CREDENTIAL_ENCRYPTION_KEY=
SMS_CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
SMS_CREDENTIAL_DECRYPTION_KEYS=
# `live` permits real server-to-server Sadad traffic after the callback, redirect profile and static outbound IP
# are registered. The administrator must still enable/default the configured adapter in Dashboard Settings.
# MerchantId, TerminalId and TerminalKey belong only in encrypted provider revisions, never in this file or Git.
SADAD_TRANSPORT_MODE=disabled
# Bounded server-to-server protocol timeout in milliseconds; a timeout is ambiguous and requires reconciliation.
SADAD_REQUEST_TIMEOUT_MS=5000
# Leave blank until merchant acceptance registers this exact public HTTPS callback. No query or fragment is allowed.
SADAD_RETURN_URL=
# Public app result page. The callback appends only the internal orderId after server-side Verify.
SADAD_RESULT_URL=
# Leave blank until merchant acceptance confirms exactly one code-owned redirect profile: PDF_PURCHASE,
# PHP_VPG_PURCHASE, or DOTNET_PURCHASE_INDEX.
SADAD_REDIRECT_PROFILE=
# External managed-secret value only: canonical base64 for exactly 32 random bytes. Do not commit a real value.
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=
PAYMENT_CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
# During a version rotation, this external managed-secret value retains only historic decrypt keys as
# comma-separated `version:canonical-base64-32-byte-key` entries. Leave empty when no retired key is needed.
# It cannot enable Sadad and must never contain a real value in Git, logs, database plaintext or local examples.
PAYMENT_CREDENTIAL_DECRYPTION_KEYS=
# Development-only product media (disabled unless explicitly configured).
PRODUCT_MEDIA_STORAGE_MODE=disabled
R2_ENDPOINT=https://08d35c2cd0dd238e8110abeb478142d2.r2.cloudflarestorage.com
R2_BUCKET=dev-sabz
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REQUEST_TIMEOUT_MS=5000
# In containers, R2_ACCESS_KEY_ID_FILE and R2_SECRET_ACCESS_KEY_FILE may point to mounted secrets.
# Do not enable storage in production or expose these values in NEXT_PUBLIC_*.
