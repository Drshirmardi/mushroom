# Copy to ~/mushroom/staging/runtime.env and ~/mushroom/production-sim/runtime.env.
# This file contains public/runtime settings only. Keep secret values in ./secrets/.

MUSHROOM_ENVIRONMENT=staging
COMPOSE_PROJECT_NAME=mushroom-staging
MUSHROOM_ENV_ROOT=/home/deploy/mushroom/staging

# Pin the database runtime used by this non-production rehearsal.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=mushroom_staging
POSTGRES_USER=mushroom_staging

PUBLIC_API_URL=https://staging-api.example.com
PUBLIC_WEB_URL=https://staging.example.com
PUBLIC_APP_URL=https://staging-app.example.com
PUBLIC_DASHBOARD_URL=https://staging-dashboard.example.com
APP_ORIGINS=https://staging.example.com,https://staging-app.example.com,https://staging-dashboard.example.com
TRUSTED_PROXIES=127.0.0.1/32
PAYMENT_CREDENTIAL_ENCRYPTION_KEY_VERSION=v1

# Bind application ports to loopback; expose only the reverse proxy on 80/443.
API_PORT=127.0.0.1:3103
WEB_PORT=127.0.0.1:3100
APP_PORT=127.0.0.1:3101
DASHBOARD_PORT=127.0.0.1:3102
