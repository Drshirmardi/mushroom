# Import INSIDE the existing merchant main-domain site (drshirmardi.com).
# This example targets the API on the same VPS at the dev API_PORT (3303).
# Use the selected environment's API port; never route production payments to dev.
handle /v1/payments/providers/sadad/callback {
    reverse_proxy 127.0.0.1:3303 {
        header_down Cache-Control "no-store"
    }
}
