FROM node:24-bookworm-slim AS build
ARG APP
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY apps/${APP}/package.json apps/${APP}/package.json
COPY packages/api-client/package.json packages/api-client/package.json
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile --store-dir /pnpm/store --package-import-method=copy
COPY . .
RUN --mount=type=cache,id=next-${APP},target=/workspace/apps/${APP}/.next/cache \
  rm -rf packages/api-client/dist packages/api-client/tsconfig.tsbuildinfo \
  && pnpm --filter @sabz-zendegi/api-client build \
  && test -f packages/api-client/dist/index.js \
  && pnpm --filter @sabz/${APP} build

FROM gcr.io/distroless/nodejs24-debian13:nonroot@sha256:9eeb7f5887d0e239e78264b06f7f11d2e14be534050481803a9e4728fcdd278e AS runner
ARG APP
WORKDIR /app/apps/${APP}
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build --chown=65532:65532 /workspace/apps/${APP}/.next/standalone /app
COPY --from=build --chown=65532:65532 /workspace/apps/${APP}/.next/static ./.next/static
COPY --from=build --chown=65532:65532 /workspace/apps/${APP}/public ./public
COPY --chown=65532:65532 deploy/docker/next-entrypoint.mjs /usr/local/bin/next-entrypoint.mjs
USER 65532:65532
EXPOSE 3000
ENTRYPOINT ["/nodejs/bin/node", "/usr/local/bin/next-entrypoint.mjs"]
