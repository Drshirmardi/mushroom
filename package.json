{
  "name": "sabz-zendegi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs --filter=@sabz-zendegi/api",
    "images:print": "node scripts/release-images.mjs print",
    "images:build": "node scripts/release-images.mjs build",
    "images:verify": "node scripts/release-images.mjs verify",
    "images:push": "node scripts/release-images.mjs push",
    "release:test": "node scripts/test-release-pipeline.mjs",
    "release:test:vps": "bash scripts/test-vps-deploy.sh",
    "generate:api-client": "corepack pnpm --filter @sabz-zendegi/api openapi:export && corepack pnpm --filter @sabz-zendegi/api-client generate",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:capacity": "pnpm --filter @sabz-zendegi/api test:capacity",
    "test:isolated": "node scripts/with-disposable-postgres.mjs workspace",
    "test:integration:reminders": "node scripts/with-disposable-postgres.mjs reminders",
    "test:integration:outbox": "node scripts/with-disposable-postgres.mjs outboxAfterChat",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "3.9.10",
    "turbo": "^2.5.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/platform-fastify>fastify": "5.12.5",
      "brace-expansion@5.0.9": "5.0.11",
      "fast-uri@3.1.5": "3.1.7",
      "fast-uri@4.1.2": "4.1.4",
      "@prisma/config>deepmerge-ts": "8.0.2",
      "prisma>mysql2": "3.24.5"
    },
    "patchedDependencies": {
      "stanza@12.22.1": "patches/stanza@12.22.1.patch"
    }
  },
  "packageManager": "pnpm@10.10.0"
}
