  "info": {
    "title": "Sabz Zendegi API",
    "description": "REST API for Sabz Zendegi clinic services.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-sz_refresh",
        "description": "HttpOnly refresh cookie. Local development uses sz_refresh_dev."
      }
    },
    "schemas": {
      "RegisterRequestDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "09123456789",
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "example": "correct horse battery staple",
            "minLength": 15,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "phone",
          "password"
        ]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "phone": {
            "type": "string",
            "example": "+989123456789"
          },
          "roles": {
            "type": "array",
            "example": [
              "PATIENT"
            ],
            "items": {
              "type": "string",
              "enum": [
                "PATIENT",
                "DOCTOR",
                "STAFF",
                "ADMIN"
              ]
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "phone",
          "roles",
          "createdAt"
        ]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "BAD_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "UNPROCESSABLE_ENTITY",
              "TOO_MANY_REQUESTS",
              "SERVICE_UNAVAILABLE",
              "INVALID_PHONE_NUMBER",
              "PHONE_ALREADY_REGISTERED",
              "PASSWORD_TOO_SHORT",
              "PASSWORD_TOO_LONG",
              "PASSWORD_UNSUPPORTED_CHARACTERS",
              "PASSWORD_BLOCKED",
              "INVALID_CREDENTIALS",
              "LOGIN_RATE_LIMITED",
              "REGISTRATION_RATE_LIMITED",
              "REFRESH_RATE_LIMITED",
              "INVALID_REFRESH_TOKEN",
              "INVALID_CURRENT_PASSWORD",
              "PASSWORD_UNCHANGED",
              "ORIGIN_NOT_ALLOWED",
              "HTTP_ERROR",
              "INTERNAL_SERVER_ERROR"
            ],
            "example": "UNAUTHORIZED"
          },
          "message": {
            "type": "string",
            "example": "Request failed"
          },
          "requestId": {
            "type": "string",
            "example": "0d43e245-9b4f-48c6-b6d8-88c472d87890"
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "example": {}
          }
        },
        "required": [
          "code",
          "message",
          "requestId",
          "details"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "09123456789",
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 128
          },
          "remember": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "phone",
          "password"
        ]
      },
      "AuthenticatedUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "phone": {
            "type": "string",
            "example": "+989123456789"
          },
          "roles": {
            "type": "array",
            "example": [
              "PATIENT"
            ],
            "items": {
              "type": "string",
              "enum": [
                "PATIENT",
                "DOCTOR",
                "STAFF",
                "ADMIN"
              ]
            }
          }
        },
        "required": [
          "id",
          "phone",
          "roles"
        ]
      },
      "AuthenticationResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "format": "jwt"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ],
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "number",
            "example": 600
          },
          "user": {
            "$ref": "#/components/schemas/AuthenticatedUserDto"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "user"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "SessionListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "current": {
            "type": "boolean"
          },
          "remembered": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "lastUsedAt": {
            "format": "date-time",
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "current",
          "remembered",
          "createdAt",
          "lastUsedAt",
          "expiresAt"
        ]
      },
      "SessionListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionListItemDto"
            }
          },
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
